<Window x:Class="Aerocat.Client.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conversation with {ContactName}" Height="400" Width="500"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="#FFFFFFFF">

    <Window.Resources>
        <LinearGradientBrush x:Key="ChatTitleBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF4A90E2" Offset="0"/>
            <GradientStop Color="#FF2E5BBA" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF0066CC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF004499"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF0080FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF0052AA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- Chat header -->
        <Border Grid.Row="0" Background="{StaticResource ChatTitleBrush}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="20" Height="20" x:Name="ContactStatusIndicator" 
                        Fill="LimeGreen" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ContactNameLabel" Text="Contact Name" 
                              Foreground="White" FontWeight="Bold" FontSize="12" FontFamily="Tahoma"/>
                    <TextBlock x:Name="ContactStatusLabel" Text="Online" 
                              Foreground="White" FontSize="10" FontFamily="Tahoma" Opacity="0.9"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="📹" Width="30" Height="25" Margin="2" 
                           ToolTip="Video Call" Background="Transparent" BorderThickness="0" 
                           Foreground="White" FontSize="12"/>
                    <Button Content="📞" Width="30" Height="25" Margin="2" 
                           ToolTip="Voice Call" Background="Transparent" BorderThickness="0" 
                           Foreground="White" FontSize="12"/>
                    <Button Content="📁" Width="30" Height="25" Margin="2" 
                           ToolTip="Send File" Background="Transparent" BorderThickness="0" 
                           Foreground="White" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat messages area -->
        <Border Grid.Row="1" Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" 
                         Background="White" Padding="10">
                <StackPanel x:Name="MessagesPanel">
                    <!-- Sample messages for demo -->
                    <Border Background="#FFF0F8FF" BorderBrush="#FFCCCCCC" BorderThickness="1" 
                           CornerRadius="8" Margin="0,5" Padding="8" HorizontalAlignment="Left" MaxWidth="300">
                        <StackPanel>
                            <TextBlock Text="" FontSize="9" Foreground="#FF666666" 
                                      FontFamily="Tahoma" Margin="0,0,0,2"/>
                            <TextBlock Text="" FontSize="11" FontFamily="Tahoma" 
                                      TextWrapping="Wrap"/>
                            <TextBlock Text="" FontSize="8" Foreground="#FF999999" 
                                      HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFE8F5E8" BorderBrush="#FFCCCCCC" BorderThickness="1" 
                           CornerRadius="8" Margin="0,5" Padding="8" HorizontalAlignment="Right" MaxWidth="300">
                        <StackPanel>
                            <TextBlock Text="" FontSize="9" Foreground="#FF666666" 
                                      FontFamily="Tahoma" Margin="0,0,0,2"/>
                            <TextBlock Text="" FontSize="11" FontFamily="Tahoma" 
                                      TextWrapping="Wrap"/>
                            <TextBlock Text="" FontSize="8" Foreground="#FF999999" 
                                      HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Message input area -->
        <Border Grid.Row="2" Background="#FFF8F8F8" BorderBrush="#FFCCCCCC" BorderThickness="1,0,1,1">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Formatting toolbar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#FFF0F0F0" 
                           Height="22" Margin="0,0,0,3">
                    <Button Content="B" Width="22" Height="20" FontWeight="Bold" 
                           ToolTip="Bold" Margin="1" FontSize="10"/>
                    <Button Content="I" Width="22" Height="20" FontStyle="Italic" 
                           ToolTip="Italic" Margin="1" FontSize="10"/>
                    <Button Content="U" Width="22" Height="20" 
                           ToolTip="Underline" Margin="1" FontSize="10"/>
                    <Button Content="🎨" Width="22" Height="20" 
                           ToolTip="Text Color" Margin="1" FontSize="9"/>
                    <Button Content="😊" Width="22" Height="20" 
                           ToolTip="Emoticons" Margin="1" FontSize="9"/>
                    <Button Content="🖼️" Width="22" Height="20" 
                           ToolTip="Insert Image" Margin="1" FontSize="8"/>
                </StackPanel>

                <!-- Message input -->
                <TextBox Grid.Row="1" x:Name="MessageInput" TextWrapping="Wrap" 
                        AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                        FontSize="11" FontFamily="Tahoma" Padding="5"
                        BorderBrush="#FFCCCCCC" BorderThickness="1"/>
            </Grid>
        </Border>

        <!-- Send controls -->
        <Border Grid.Row="3" Background="#FFF0F0F0" BorderBrush="#FFCCCCCC" BorderThickness="1,0,1,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Press Enter to send message" 
                          VerticalAlignment="Center" Margin="8,0" 
                          FontSize="9" FontFamily="Tahoma" Foreground="#FF666666"/>

                <Button Grid.Column="1" Content="Cancel" Width="60" Height="25" Margin="5" 
                       FontSize="10" FontFamily="Tahoma"/>
                <Button Grid.Column="2" x:Name="SendButton" Content="Send" Width="60" Height="25" Margin="5" 
                       FontSize="10" FontFamily="Tahoma" Style="{StaticResource SendButtonStyle}"/>
            </Grid>
        </Border>
    </Grid>
</Window>