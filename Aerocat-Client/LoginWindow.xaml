<Window x:Class="Aerocat.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aerocat - Login" Height="250" Width="300"
        WindowStyle="SingleBorderWindow" ResizeMode="CanMinimize"
        Background="#FF0066CC" WindowStartupLocation="CenterScreen">
    <Grid Margin="0,0,0,-26" Background="White">
        <StackPanel VerticalAlignment="Center" Margin="20">
            <TextBlock Text="Username" FontFamily="Tahoma" Foreground="Black"/>
            <TextBox x:Name="UsernameTextBox" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Password" Foreground="#FF191919" FontFamily="Tahoma"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,5,0,15" Padding="5"/>

            <Button x:Name="LoginButton" Content="Sign In" Click="LoginButton_Click" 
                    Background="#FF4A90E2" Foreground="White" Padding="5" FontWeight="Bold"/>

            <Button x:Name="SwitchToRegisterButton" Content="Don't have an account? Register" 
                    Click="SwitchToRegisterButton_Click" Background="Transparent" 
                    BorderThickness="0" Foreground="Black" Margin="0,10,0,0" FontWeight="Bold"/>

            <TextBlock x:Name="ErrorTextBlock" Foreground="Yellow" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>