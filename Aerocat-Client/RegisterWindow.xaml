<Window x:Class="Aerocat.Client.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aerocat - Register" Height="250" Width="300"
        WindowStyle="SingleBorderWindow" ResizeMode="CanMinimize"
        Background="#FF0066CC" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="20">
            <TextBlock Text="Username" Foreground="White" FontFamily="Tahoma"/>
            <TextBox x:Name="UsernameTextBox" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Password" Foreground="White" FontFamily="Tahoma"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,5,0,15" Padding="5"/>

            <Button x:Name="RegisterButton" Content="Register" Click="RegisterButton_Click" 
                    Background="#FF4A90E2" Foreground="White" Padding="5" FontWeight="Bold"/>

            <Button x:Name="SwitchToLoginButton" Content="Already have an account? Sign In" 
                    Click="SwitchToLoginButton_Click" Background="Transparent" 
                    BorderThickness="0" Foreground="White" Margin="0,10,0,0"/>

            <TextBlock x:Name="ErrorTextBlock" Foreground="Yellow" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>